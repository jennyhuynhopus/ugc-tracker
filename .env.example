# Copy to .env.local for local runs. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# Required: Postgres connection string. On Supabase use the pooler URL
# (Connect → Transaction pooler, port 6543).
DATABASE_URL=

# Required online: the password your team types to open the app.
APP_PASSWORD=

# Required online: random string the scheduler sends to /api/cron/tick.
# Generate one with: openssl rand -hex 24
CRON_SECRET=

# Automatic stats for TikTok, Instagram, Facebook (and YouTube).
SCRAPECREATORS_API_KEY=

# Optional: free YouTube stats (Google Cloud → YouTube Data API v3 → API key).
YOUTUBE_API_KEY=

# Optional: AI-written weekly digests. Without it, digests use the numbers only.
ANTHROPIC_API_KEY=
