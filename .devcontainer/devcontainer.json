{
  "name": "UGC Tracker",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "npm ci",
  "forwardPorts": [
    3200
  ],
  "portsAttributes": {
    "3200": {
      "label": "UGC Tracker",
      "onAutoForward": "openBrowser"
    },
    "55433": {
      "label": "Local database",
      "onAutoForward": "ignore"
    }
  },
  "secrets": {
    "SCRAPECREATORS_API_KEY": {
      "description": "ScrapeCreators API key, for pulling video stats."
    },
    "APP_PASSWORD": {
      "description": "Password your team types to open the shared link."
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "postStartCommand": "nohup npm run local > /tmp/ugc-tracker.log 2>&1 &"
}
