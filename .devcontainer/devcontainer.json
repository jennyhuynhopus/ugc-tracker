{
  "name": "UGC Tracker",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "npm ci",
  "postAttachCommand": { "site": "npm run local" },
  "forwardPorts": [3200],
  "portsAttributes": {
    "3200": { "label": "UGC Tracker", "onAutoForward": "openBrowser" },
    "55433": { "label": "Local database", "onAutoForward": "ignore" }
  },
  "secrets": {
    "SCRAPECREATORS_API_KEY": { "description": "ScrapeCreators API key, for pulling video stats." },
    "APP_PASSWORD": { "description": "Password your team types to open the shared link." }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
